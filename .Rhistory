ggplot(counts_long, aes(x = Superpopulation, y = Count, fill = Genotype)) +
geom_bar(stat = "identity", position = "dodge") +
labs(title = "Genotype Distribution by Superpopulation",
x = "Superpopulation",
y = "Number of Genotypes") +
scale_fill_manual(values = c("REF" = "#1b9e77", "HET" = "#d95f02", "ALT" = "#7570b3")) +  # Color-blind friendly
theme_minimal(base_size = 14)
# Convert to proportion within each superpopulation
counts_prop <- counts %>%
pivot_longer(cols = c("REF", "HET", "ALT"),
names_to = "Genotype", values_to = "Count") %>%
group_by(Superpopulation) %>%
mutate(Proportion = Count / sum(Count))
# Plot
ggplot(counts_prop, aes(x = Superpopulation, y = Proportion, fill = Genotype)) +
geom_bar(stat = "identity", position = "stack") +
labs(title = "Proportion of Genotypes by Superpopulation",
x = "Superpopulation", y = "Proportion") +
scale_y_continuous(labels = scales::percent_format()) +
scale_fill_manual(values = c("REF" = "#1b9e77", "HET" = "#d95f02", "ALT" = "#7570b3")) +
theme_minimal(base_size = 14)
