# ===== PCA ANALYSIS OF GENOTYPE DATA =====

# ===============================
# 1. Prepare Genotype Matrix
# ===============================
# G should already contain: Sample, Superpop, and genotype columns
# Remove non-numeric columns
geno_matrix <- G %>%
  select(-Sample, -Superpop) %>%
  as.matrix()

# Replace NA values with 0 to avoid PCA errors
geno_matrix[is.na(geno_matrix)] <- 0

# Confirm matrix shape
cat("Genotype matrix dimensions: ", dim(geno_matrix)[1], "samples x", dim(geno_matrix)[2], "variants\n")

# ===============================
# 2. Run PCA
# ===============================
pca_res <- prcomp(geno_matrix, center = TRUE, scale. = TRUE)

# ===============================
# 3. Prepare PCA Output
# ===============================
pca_df <- as.data.frame(pca_res$x[, 1:2]) %>%
  mutate(
    Sample = G$Sample,
    Superpop = G$Superpop
  )

# ===============================
# 4. Plot PCA
# ===============================
ggplot(pca_df, aes(x = PC1, y = PC2, color = Superpop)) +
  geom_point(size = 3, alpha = 0.8) +
  labs(
    title = "PCA of Chromosome 1 Cancer-Linked Variants",
    x = paste0("PC1 (", round(100 * summary(pca_res)$importance[2,1], 2), "% variance)"),
    y = paste0("PC2 (", round(100 * summary(pca_res)$importance[2,2], 2), "% variance)"),
    color = "Superpopulation"
  ) +
  theme_minimal() +
  theme(legend.position = "right")

# ===============================
# 5. Save PCA Plot
# ===============================
ggsave("fig_PCA_chr1.png", width = 7, height = 5, dpi = 300)

# ===============================
# 6. Optional – View Clustering Counts
# ===============================
cat("Sample counts by Superpopulation:\n")
print(table(pca_df$Superpop))


