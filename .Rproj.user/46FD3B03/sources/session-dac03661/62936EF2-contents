sig_variants <- final_results %>%
  filter(FDR < 0.05)

# Check how many significant variants
cat("Number of significant variants:", nrow(sig_variants), "\n")

# 4. Prepare data for heatmap
# Assuming you have allele frequencies for AFR, AMR, EAS, EUR, SAS
