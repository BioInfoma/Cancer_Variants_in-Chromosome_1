sig_variants_long <- sig_variants %>%
  select(VarID, starts_with("AF_")) %>%
  pivot_longer(
    cols = -VarID,
    names_to = "Population",
    values_to = "AF"
  ) %>%
  mutate(Population = sub("^AF_", "", Population)) # Clean population names

# 5. Plot heatmap
heatmap_plot <- ggplot(sig_variants_long, aes(x = Population, y = factor(VarID), fill = AF)) +
  geom_tile() +
  scale_fill_viridis_c(option = "plasma") +
  labs(
    title = "Allele Frequencies of Significant Variants",
    x = "Superpopulation",
    y = "Variant",
    fill = "Allele Frequency"
  ) +
  theme_minimal() +
  theme(
    axis.text.y = element_blank(), # Hide variant IDs if there are many
    axis.ticks.y = element_blank()
  )

# Display the plot
print(heatmap_plot)

# 6. Save the heatmap to file
ggsave("fig_sig_variant_heatmap.png", plot = heatmap_plot, width = 8, height = 6, dpi = 300)

# 7. Save the filtered significant variants for reference
write_tsv(sig_variants, "significant_variants.tsv")

